# ===== 必填 =====

# ===== 数据库（本地 / 远程切换）=====

# 远程 Neon PostgreSQL 云数据库连接串
# 1. 前往 https://neon.tech → 注册（GitHub 一键登录）
# 2. 创建项目 → Connection Details → 复制 Pooled connection 字符串
# 3. 格式：postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
REMOTE_DATABASE_URL="postgresql://..."

# 本地本机 PostgreSQL 连接串（用户名/密码/库名自行提供）
# 例如：postgresql://postgres:你的密码@localhost:5432/julesite
LOCAL_DATABASE_URL="postgresql://..."

# 当前生效的连接串 —— 勿手改，由以下命令自动改写：
#   npm run db:local   → 切到 LOCAL_DATABASE_URL
#   npm run db:remote  → 切到 REMOTE_DATABASE_URL
DATABASE_URL="postgresql://..."

# 站点登录凭证（全站浏览认证，用户名+密码）
SITE_USERNAME="your-username"
SITE_PASSWORD="your-secure-password"

# 管理员密码（管理后台增删改，独立于站点登录）
ADMIN_PASSWORD="your-admin-password"

# Session 加密密钥
# 生成方式：openssl rand -hex 32
SESSION_SECRET="replace-with-random-32-bytes-hex"

# ===== 可选 =====

# Steam Web API Key
# 申请地址：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# IGDB API（需要注册 Twitch 开发者应用）
# 注册地址：https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
