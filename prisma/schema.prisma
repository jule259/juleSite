// Prisma schema — PostgreSQL via Neon
// learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              String    @id @default(cuid())
  title           String
  titleZh         String?
  platforms       String[]  @default([])
  genres          String[]  @default([])
  status          String    @default("backlog")
  rating          Int?
  playTimeHours   Float?
  playYear        Int?
  developer       String?
  publisher       String?
  steamAppId      String?
  coverImageUrl   String?
  screenshots     Json      @default("[]")
  notes           String?
  isRecommended   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UpcomingGame {
  id            String    @id @default(cuid())
  title         String
  titleZh       String?
  releaseDate   DateTime?
  platforms     String[]  @default([])
  genres        String[]  @default([])
  price         String?
  summary       String?
  coverImageUrl String?
  screenshots   Json      @default("[]")
  steamAppId    String?
  developer     String?
  publisher     String?
  isInterested  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
